# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/esports_stats

# Base URL of a VLR-compatible API adapter you operate or are authorized to use.
# Example local self-hosted adapter: http://127.0.0.1:3001
VLR_API_BASE_URL=http://127.0.0.1:3001

# Keep request volume conservative.
REQUEST_TIMEOUT_SECONDS=30
REQUEST_DELAY_SECONDS=1.5
USER_AGENT=EsportsStatsDatabase/0.1 (research; contact: replace-with-your-contact)
